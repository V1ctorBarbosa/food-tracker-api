rules_version = '2';

// Every read and write goes through the API, which uses the Admin SDK and is not subject to these
// rules. No client talks to Firestore directly, so nothing reached through the public web config
// (apiKey, projectId) may touch the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
