<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>61f0306d-eda1-42b8-96b8-24164487de61</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <!-- Pinned above the transitive 2.0.0 pulled in by Microsoft.AspNetCore.OpenApi 10.0.2, which has a known high-severity vulnerability (GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <!-- Lets this same Minimal API run as an AWS Lambda function (see AddAWSLambdaHosting in Program.cs) with zero change to local dev, where it's a no-op and Kestrel serves as usual. -->
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FoodTrack.Application\FoodTrack.Application.csproj" />
    <ProjectReference Include="..\FoodTrack.Infrastructure\FoodTrack.Infrastructure.csproj" />
  </ItemGroup>

</Project>
